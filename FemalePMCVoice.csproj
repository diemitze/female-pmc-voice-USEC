<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RootNamespace>FemalePMCVoice</RootNamespace>
    <AssemblyName>FemalePMCVoice</AssemblyName>
    <Version>1.0.1</Version>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SPTarkov.Common" Version="4.0.13" />
    <PackageReference Include="SPTarkov.DI" Version="4.0.13" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.0.13" />
    <!-- Update version to whatever is current on NuGet for WTT-ServerCommonLib -->
    <PackageReference Include="WTT-ServerCommonLib" Version="2.0.0" />
  </ItemGroup>

  <!-- Web SDK auto-includes these as Content; Update just adds CopyToOutputDirectory -->
  <ItemGroup>
    <Content Update="db\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="bundles.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="bundles\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Deploy to SPT on build. Change the path if your SPT install lives elsewhere. -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <_DeployFiles Include="$(TargetDir)**\*.*" />
    </ItemGroup>
    <MakeDir Directories="D:\SPT dev\SPT\user\mods\FemalePMCVoice" />
    <Copy SourceFiles="@(_DeployFiles)"
          DestinationFiles="@(_DeployFiles->'D:\SPT dev\SPT\user\mods\FemalePMCVoice\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
